{
  "onnx_path": "./models/segment.onnx",
  "target_path": "./models/segment.engine",
  "model_information": {
    "name": "YOLOv8 Segment",
    "description": "YOLOv8 instance segmentation model for fire/smoke detection",
    "input_tensors": [
      {"name": "images", "dimensions": [1, 3, 640, 640], "description": "(Batch, Channel, Height, Width)"}
    ],
    "output_tensors": [
      {"name": "output0", "dimensions": [1, 116, 8400], "description": "Detection outputs"},
      {"name": "output1", "dimensions": [1, 32, 160, 160], "description": "Segmentation mask protos"}
    ]
  },
  "trt_config": {
    "precision": "fp16",
    "use_nvdla": false,
    "verbose": true,
    "use_spin_wait": false
  }
}
