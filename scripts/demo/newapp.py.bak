import traceback
from argparse import Namespace
from collections import deque
from typing import List

from cv2 import VideoCapture
from numpy import ndarray

from scripts.common.db_proxy import DBProxy
from scripts.demo.predictor import Predictor


class NewApp:
    def run(self, args: Namespace) -> bool:
        result = True
        try:
            db_proxy = DBProxy()
            with db_proxy.connection(
                    args.db_host, args.db_name, args.db_user, args.db_secret
            ):
                frame_interval_ms = db_proxy.get_config_as_int("frame_sampling_interval")
                frame_cnt = db_proxy.get_config_as_int("clip_frame_count")

            pred = Predictor(
                args.spatial_model,
                args.spatial_detection_threshold,
                args.temporal_model,
            )

            stream = VideoCapture(args.stream)
            if not stream.isOpened():
                raise IOError(f"Failed to open stream: {args.stream}")

            # 读取前 20 帧存入 list
            frames = []
            for frame_index in range(30):
                ret, frame = stream.read()
                if not ret:
                    break
                timestamp_sec = frame_index * 1e-3 * frame_interval_ms
                frames.append((frame, timestamp_sec))

            self.detect(pred, frames, frame_cnt)
        except KeyboardInterrupt:
            print("Interrupted by user")
        except BaseException:
            result = False
            print(f"Error: {traceback.format_exc()}")
        return result

    def detect(
            self,
            predictor: Predictor,
            frames: List[tuple[ndarray, float]],
            clip_frame_count: int,
    ):
        frame_buf: list[tuple[ndarray, float]] = []
        event_state_buf = deque(maxlen=100)
        # 结果列表，用来存储所有检测结果
        results_dict = {}

        # 遍历提供的帧数据
        for frame, start_time in frames:
            frame_buf.append((frame, start_time))
            # 如果收集的帧数还不够 clip 的数量，继续等待
            if len(frame_buf) < clip_frame_count:
                continue

            # 模型预测
            if pred := predictor.predict(tuple(f for f, _ in frame_buf)):
                event_state_buf.append(True)
                print(f"[{start_time:.2f}秒] Fire detected")
                bboxes = '\n'.join(' ' * 4 + str(b) for b in pred.bboxes)
                print(f"Fire detected: score({pred.score}), bboxes:\n{bboxes}")

                # 遍历当前窗口的前 5 帧，填充结果
                for idx, (frame, ts) in enumerate(frame_buf[:(clip_frame_count // 2)]):
                    results_dict[ts] = {
                        "timestamp_sec": ts,
                        "type": [1] * len(pred.bboxes[idx]) if idx < len(pred.bboxes) else [],
                        "score": pred.spatial_confidences[idx] if idx < len(pred.spatial_confidences) else [],
                        "bboxes": pred.bboxes[idx] if idx < len(pred.bboxes) else []
                    }
            else:
                event_state_buf.append(False)
                print(f"[{start_time:.2f}秒] Nothing detected")

                # 当前 clip 的前 5 帧都应该是没有火
                for frame, ts in frame_buf[:(clip_frame_count // 2)]:
                    results_dict[ts] = {
                        "timestamp_sec": ts,
                        "type": [],
                        "score": [],
                        "bboxes": []
                    }

            # Slide window
            del frame_buf[:clip_frame_count // 2]

        # 最后处理剩下的帧（如果还有）
        if frame_buf:
            if pred := predictor.predict(tuple(f for f, _ in frame_buf)):
                for idx, (frame, ts) in enumerate(frame_buf):
                    results_dict[ts] = {
                        "timestamp_sec": ts,
                        "type": [1] * len(pred.bboxes[idx]) if idx < len(pred.bboxes) else [],
                        "score": pred.spatial_confidences[idx] if idx < len(pred.spatial_confidences) else [],
                        "bboxes": pred.bboxes[idx] if idx < len(pred.bboxes) else []
                    }
            else:
                for frame, ts in frame_buf:
                    results_dict[ts] = {
                        "timestamp_sec": ts,
                        "type": [],
                        "score": [],
                        "bboxes": []
                    }

        print(f"[事件event_state_buf = {event_state_buf}")
        results = [results_dict[t] for t in sorted(results_dict)]
        print(f"[检测结果 results = {results}]")

        # 最终按照传入顺序返回所有结果
        # return results
